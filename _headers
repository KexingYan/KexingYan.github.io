# Cloudflare Pages custom headers.
# Keep résumé PDFs from appearing as standalone search results. This is an
# indexing preference, not a privacy control; the files remain intentionally
# reachable from the public homepage.
/assets/resume/*
  X-Robots-Tag: noindex

# The paper remains indexable and readable inline. Its URL is stable, so use a
# short cache lifetime rather than immutable caching.
/papers/the-quantity-and-size-of-microloans.pdf
  Content-Type: application/pdf
  Content-Disposition: inline
  Content-Language: en-CA
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=3600, must-revalidate

/assets/images/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
