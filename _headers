# Cloudflare Pages custom headers.
# Keep résumé PDFs out of search indexes: they contain a plaintext personal
# email that would otherwise be exposed to crawlers. Trade-off: the résumé
# files themselves will not appear in search results.
/assets/resume/*
  X-Robots-Tag: noindex

# Offline owner prototype. Cloudflare Access must be attached before any future
# production exposure, and the application API must validate Access JWTs.
/studio/*
  X-Robots-Tag: noindex, nofollow
